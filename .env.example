# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # secreto: solo en Netlify, nunca en el navegador

# Mercado Pago (cuenta de King, Argentina) → Developers → Tus integraciones → Credenciales
MP_ACCESS_TOKEN=                  # empieza con APP_USR- (usar credenciales de prueba primero)
MP_WEBHOOK_SECRET=                # Webhooks → clave secreta (opcional pero recomendado)

# URL pública del sitio (sin barra final). Primero la de Netlify (https://xxxx.netlify.app),
# después el dominio propio. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://kinginsumostienda.netlify.app

# Cualquier texto largo al azar; lo usa la tarea diaria (netlify/functions/mantenimiento-diario.mjs)
CRON_SECRET=
